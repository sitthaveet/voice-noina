+void InferenceNode::cancel_voice_wave() {
+    std::lock_guard<std::mutex> lock(mode_mutex_);
+    if (voice_wave_) {
+        switch_policy_locked(0);
+    }
+}
+
+void InferenceNode::set_wave(std_srvs::srv::SetBool::Request::SharedPtr request,
+                             std_srvs::srv::SetBool::Response::SharedPtr response) {
+    try {
+        if (!request->data) {
+            cancel_voice_wave();
+            response->success = true;
+            return;
+        }
+        std::lock_guard<std::mutex> lock(mode_mutex_);
+        std::lock_guard<std::mutex> reset_lock(reset_thread_mutex_);
+        if (is_joy_control_ || !is_running_ || !robot_->is_init_ || reset_thread_running_) {
+            response->message = "Wave needs running inference and gamepad Y handoff";
+            return;
+        }
+        if (!voice_wave_) {
+            if (active_policy_idx_ != 0) {
+                response->message = "Return to walking mode before requesting a wave";
+                return;
+            }
+            {
+                std::lock_guard<std::mutex> cmd_lock(cmd_mutex_);
+                std::fill(cmd_vel_.begin(), cmd_vel_.end(), 0.0f);
+            }
+            switch_policy_locked(wave_policy_idx_);
+            voice_wave_ = true;
+        }
+        response->success = true;
+    } catch (const std::exception& e) {
+        response->message = e.what();
+    }
+}
